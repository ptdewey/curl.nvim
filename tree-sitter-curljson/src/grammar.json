{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "curljson",
  "rules": {
    "document": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "request"
        },
        {
          "type": "SYMBOL",
          "name": "directory"
        },
        {
          "type": "SYMBOL",
          "name": "status"
        },
        {
          "type": "SYMBOL",
          "name": "elapsed"
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        },
        {
          "type": "SYMBOL",
          "name": "stdout"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "stderr"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "request": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "Request:"
        },
        {
          "type": "STRING",
          "value": " "
        },
        {
          "type": "FIELD",
          "name": "title",
          "content": {
            "type": "SYMBOL",
            "name": "request_title"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "request_title": {
      "type": "PATTERN",
      "value": "[^\\r\\n]+"
    },
    "directory": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "Directory:"
        },
        {
          "type": "STRING",
          "value": " "
        },
        {
          "type": "FIELD",
          "name": "path",
          "content": {
            "type": "SYMBOL",
            "name": "directory_path"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "directory_path": {
      "type": "PATTERN",
      "value": "[^\\r\\n]+"
    },
    "status": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "Status:"
        },
        {
          "type": "STRING",
          "value": " "
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "exit_code"
              },
              {
                "type": "SYMBOL",
                "name": "cancelled"
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "exit_code": {
      "type": "PATTERN",
      "value": "-?[0-9]+"
    },
    "cancelled": {
      "type": "STRING",
      "value": "cancelled"
    },
    "elapsed": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "Elapsed:"
        },
        {
          "type": "STRING",
          "value": " "
        },
        {
          "type": "FIELD",
          "name": "duration",
          "content": {
            "type": "SYMBOL",
            "name": "duration"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "duration": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "[0-9]+\\.[0-9]+"
        },
        {
          "type": "STRING",
          "value": "s"
        }
      ]
    },
    "stdout": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "stdout_header"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "body",
              "content": {
                "type": "SYMBOL",
                "name": "stdout_body"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "stdout_header": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "stdout:"
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "stdout_body": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_line_text"
          },
          {
            "type": "SYMBOL",
            "name": "_newline"
          }
        ]
      }
    },
    "stderr": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "stderr_header"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "body",
              "content": {
                "type": "SYMBOL",
                "name": "stderr_body"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "stderr_header": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "stderr:\\r?\\n"
        }
      }
    },
    "stderr_body": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_line_text"
          },
          {
            "type": "SYMBOL",
            "name": "_newline"
          }
        ]
      }
    },
    "_line_text": {
      "type": "PATTERN",
      "value": "[^\\n]+"
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}